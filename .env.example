CLASSFLOW_PROJECT_NAME=ClassFlow
CLASSFLOW_ENVIRONMENT=local
CLASSFLOW_DEBUG=true
CLASSFLOW_API_V1_PREFIX=/api/v1

# Replace these before using a real database.
CLASSFLOW_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/classflow

# Generate a strong value before auth work starts.
CLASSFLOW_SECRET_KEY=change-me-in-local-env
CLASSFLOW_JWT_ALGORITHM=HS256
CLASSFLOW_ACCESS_TOKEN_EXPIRE_MINUTES=30
CLASSFLOW_REFRESH_TOKEN_EXPIRE_DAYS=7
CLASSFLOW_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
CLASSFLOW_FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password

# JSON list so pydantic-settings can parse it reliably.
CLASSFLOW_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# RAG/chatbot settings.
CLASSFLOW_OPENAI_API_KEY=
CLASSFLOW_GEMINI_API_KEY=
CLASSFLOW_GEMINI_GENERATION_MODEL=gemini-2.5-flash-lite
CLASSFLOW_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CLASSFLOW_VECTOR_STORE_PROVIDER=pgvector
CLASSFLOW_RAG_EMBEDDING_DIMENSIONS=768
CLASSFLOW_RAG_EMBEDDING_BATCH_SIZE=20
CLASSFLOW_RAG_TOP_K=5
CLASSFLOW_RAG_MAX_DISTANCE=0.8
CLASSFLOW_RAG_CHUNK_SIZE=1000
CLASSFLOW_RAG_CHUNK_OVERLAP=150
CLASSFLOW_RAG_MAX_OUTPUT_TOKENS=800
CLASSFLOW_RAG_MAX_DOCUMENT_PAGES=200
CLASSFLOW_RAG_MAX_EXTRACTED_CHARACTERS=500000
CLASSFLOW_RAG_CHAT_FILE_MAX_SIZE_BYTES=5242880
CLASSFLOW_RAG_CHAT_FILE_MAX_PAGES=100
CLASSFLOW_RAG_CHAT_FILE_MAX_EXTRACTED_CHARACTERS=200000
CLASSFLOW_RAG_CHAT_FILE_MAX_CHUNKS=200

# Task attachment storage.
CLASSFLOW_TASK_ATTACHMENT_STORAGE_DIR=storage/task_attachments
CLASSFLOW_TASK_ATTACHMENT_MAX_SIZE_BYTES=10485760

# Private course resources; serve only through authenticated API downloads.
CLASSFLOW_COURSE_RESOURCE_STORAGE_DIR=storage/course_resources
CLASSFLOW_COURSE_RESOURCE_MAX_SIZE_BYTES=10485760
CLASSFLOW_COURSE_RESOURCE_ALLOWED_EXTENSIONS=["pdf"]
CLASSFLOW_COURSE_RESOURCE_ALLOWED_CONTENT_TYPES=["application/pdf"]

# Notifications, reminders, and dashboard previews.
CLASSFLOW_REMINDER_LEAD_MINUTES=1440
CLASSFLOW_REMINDER_BATCH_SIZE=100
CLASSFLOW_DASHBOARD_LIST_LIMIT=5
